{
  "schemaVersion": 2,
  "id": "dev.panestra.deepseek",
  "name": "DeepSeek",
  "version": "0.1.0",
  "engine": {
    "pluginApi": ">=1.0.0 <2.0.0",
    "runtime": "native-process",
    "entry": "deepseek-plugin.exe",
    "maxChildren": 1
  },
  "permissions": [
    {
      "id": "deepseek.account.read",
      "required": false
    }
  ],
  "sources": [
    {
      "id": "account.usage",
      "type": "object",
      "unit": "",
      "defaultIntervalMs": 1000
    }
  ],
  "widgets": [
    {
      "id": "account-usage",
      "renderer": "declarative",
      "subscriptions": ["account.usage"],
      "layout": {
        "desktop": {
          "minW": 2,
          "minH": 2,
          "maxW": 12,
          "maxH": 12
        },
        "tablet": {
          "minW": 2,
          "minH": 2,
          "maxW": 8,
          "maxH": 12
        },
        "mobile": {
          "minW": 2,
          "minH": 2,
          "maxW": 4,
          "maxH": 12
        }
      },
      "sizePresets": [
        {
          "id": "mini",
          "w": 2,
          "h": 2
        },
        {
          "id": "strip",
          "w": 4,
          "h": 2
        },
        {
          "id": "standard",
          "w": 4,
          "h": 3
        },
        {
          "id": "detail",
          "w": 4,
          "h": 4
        },
        {
          "id": "wide",
          "w": 6,
          "h": 3
        },
        {
          "id": "large",
          "w": 8,
          "h": 4
        }
      ],
      "presentations": [
        "auto",
        "summary",
        "details",
        "visual",
        "tiles",
        "segments"
      ],
      "defaults": {
        "title": "DeepSeek 余额",
        "source": "account.usage",
        "unit": "",
        "color": "sage",
        "valueMode": "balance"
      },
      "catalog": [
        {
          "title": "DeepSeek 余额",
          "source": "account.usage",
          "unit": "",
          "color": "sage",
          "description": "账户余额",
          "valueMode": "balance"
        }
      ]
    }
  ],
  "actions": [],
  "configSchema": {
    "type": "object"
  },
  "ui": {
    "key": "deepseek",
    "category": "status",
    "icon": "wallet",
    "subtitle": "账户余额",
    "description": "查看可用余额、赠送余额和充值余额",
    "notes": [
      "查询 API 账户余额，保留人民币与美元金额",
      "凭据由 Windows DPAPI 保护，配对设备只读取余额"
    ],
    "settings": [
      {
        "key": "apiKey",
        "label": "API Key",
        "type": "secret",
        "placeholder": "仅保存在 Core 电脑上"
      }
    ],
    "setup": false,
    "detailLabel": "用量与设置",
    "refreshLabel": "刷新用量",
    "enableLabel": "保存并启用读取",
    "permissions": {
      "deepseek.account.read": {
        "label": "读取DeepSeek状态",
        "description": "查看可用余额、赠送余额和充值余额"
      }
    }
  },
  "routes": [
    {
      "method": "GET",
      "path": "/integrations/deepseek",
      "operation": "status",
      "role": "viewer"
    },
    {
      "method": "POST",
      "path": "/integrations/deepseek",
      "operation": "configure",
      "role": "owner",
      "grantField": "enabled",
      "grant": "deepseek.account.read"
    },
    {
      "method": "POST",
      "path": "/integrations/deepseek/refresh",
      "operation": "refresh",
      "role": "viewer"
    }
  ],
  "legacyData": "deepseek.protected"
}
